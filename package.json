{
  "name": "@inticate/bot",
  "version": "0.0.1",
  "description": "A Discord.js bot framework wrapper to provide a more simple experience when developing bots.",
  "author": {
    "name": "Inticate",
    "email": "contact@inticate.com",
    "url": "https://inticate.dev"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "bun dist/index.js",
    "dev": "bun --watch src/index.ts",
    "build": "npm run clean && bun build ./src/index.ts --outdir ./dist --target node --format esm --splitting",
    "lint": "eslint src --ext .ts,.js",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "discord.js": "^14.24.2",
    "dotenv": "^17.2.3",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "bun": "^1.3.4",
    "rimraf": "^6.1.2"
  }
}